{
  "manifest_version": 3,
  "name": "ProtonMail SimpleLogin Automator",
  "version": "1.0",
  "description": "Automates reverse-alias generation for mark@southby.ca",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://proton.me/*",
    "https://simplelogin.io/*"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "action": {},
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true,
    "browser_style": false
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "mark@southby.ca"
    }
  }
}
